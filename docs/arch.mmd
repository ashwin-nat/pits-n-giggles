%% ---------------------------------------------------------------------------
%% Pits n' Giggles - high level process architecture
%% The launcher is the entry point and owns every subsystem process.
%% Thick edges = telemetry data path. Dashed = control / request path.
%% For the HUD's internal structure, see hud-arch.mmd
%% ---------------------------------------------------------------------------

flowchart LR

subgraph EXT["External"]
    direction TB
    GAME["F1 Game<br/><i>broadcasts telemetry over UDP / TCP</i>"]
    FWD["Forwarding Targets<br/><i>other tools on the network</i>"]
end

subgraph PNG["Pits n' Giggles"]
    direction LR
    MGRS["Launcher<br/><i>Qt GUI · single entry point</i><br/><i>one manager per subsystem:</i><br/><i>spawn · heartbeat · auto-restart</i><br/><i>settings push · stdout to consolidated log</i>"]

    subgraph SUBSYS["Subsystem processes"]
        direction LR
        BACKEND["Backend<br/><i>parse packets · aggregate session state</i><br/><i>overtakes, collisions, tyre wear</i>"]
        BROKER["Broker<br/><i>ZMQ pub/sub fan-out + router</i>"]
        WEB["Web<br/><i>Quart + Socket.IO server</i>"]
        HUD["HUD<br/><i>always-on-top Qt/QML overlays</i>"]
        MCP["MCP Server<br/><i>live telemetry as MCP tools</i>"]
    end
end

subgraph CLIENTS["Clients"]
    direction TB
    BROWSER["Browser<br/><i>driver &amp; engineer dashboards,<br/>save viewer, stream overlay</i>"]
    AGENT["MCP Clients<br/><i>Claude and friends</i>"]
end

%% -- launcher owns the subsystems (one manager per subsystem) --------------
MGRS -.->|"req/rep"| BACKEND
MGRS -.->|"req/rep"| BROKER
MGRS -.->|"req/rep"| WEB
MGRS -.->|"req/rep"| HUD
MGRS -.->|"req/rep"| MCP

%% -- ingest ---------------------------------------------------------------
GAME ==>|"telemetry packets"| BACKEND
BACKEND -.->|"raw packet forward"| FWD

%% -- state fan-out --------------------------------------------------------
BACKEND ==>|"state updates (PUB)"| BROKER
BROKER ==>|"SUB"| WEB
BROKER ==>|"SUB"| HUD
BROKER ==>|"SUB"| MCP

%% -- pull requests back to the backend ------------------------------------
WEB -.->|"driver-info / race-info"| BROKER
HUD -.->|"overlay commands"| BROKER
BROKER -.->|"router / dealer"| BACKEND

%% -- delivery -------------------------------------------------------------
WEB ==>|"HTTP + Socket.IO"| BROWSER
MCP ==>|"stdio / HTTP"| AGENT

%% -- styles ---------------------------------------------------------------
classDef external fill:#450a0a,stroke:#ef4444,color:#fca5a5,stroke-width:2px,font-weight:bold
classDef mgr      fill:#2e1065,stroke:#a855f7,color:#d8b4fe,stroke-width:2px,font-weight:bold
classDef backend  fill:#172554,stroke:#3b82f6,color:#93c5fd,stroke-width:2px,font-weight:bold
classDef broker   fill:#422006,stroke:#f59e0b,color:#fcd34d,stroke-width:2px,font-weight:bold
classDef consumer fill:#052e16,stroke:#22c55e,color:#86efac,stroke-width:2px,font-weight:bold
classDef client   fill:#1e1b4b,stroke:#818cf8,color:#c7d2fe,stroke-width:2px

class GAME,FWD external
class MGRS mgr
class BACKEND backend
class BROKER broker
class WEB,HUD,MCP consumer
class BROWSER,AGENT client
